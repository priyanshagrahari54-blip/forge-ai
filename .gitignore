
# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Build artifacts
build/
dist/
# PyInstaller writes a .spec next to the entry point on every build
*.spec

# IDE
.vscode/
.idea/

# Forge runtime/generated state (never committed)
.forge/*.db
.forge/*.db-shm
.forge/*.db-wal
.forge/*.db-journal
.forge/audit.jsonl
.forge/fleet-run-monitor.json
# Real probe inputs the capability fleet renders/synthesises at run time
# (a PNG, a WAV per specialist): inputs, not deliverables, and always
# regenerated — see scripts/run_capability_fleet.py.
.forge/capability-probe*
.forge/self/history/
.forge/research_cache/
.forge/index/
.forge/models/
.forge/autobuild/
